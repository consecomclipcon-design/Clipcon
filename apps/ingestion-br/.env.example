# Serviço de ingestão brasileiro (apps/ingestion-br)
# Obrigatórias
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=<service-role-key>

# Autenticação Bearer do /ingest (mesmo token configurado no worker)
INGESTION_TOKEN=<token-bearer-compartilhado>

# Opcionais
PORT=8090
# Cookies do YouTube em base64 (ou gzip+base64). Use apenas se necessário.
YTDLP_COOKIES_B64=
