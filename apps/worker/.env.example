SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=
WORKER_POLL_MS=2000
WORKER_MAX_ATTEMPTS=5

# Ingestão remota (serviço brasileiro)
# local = usa yt-dlp no próprio worker | remote = tenta serviço BR antes, com fallback local
INGESTION_PROVIDER=local
REMOTE_INGESTION_URL=https://<host-da-vps-brasileira>:8090
INGESTION_TOKEN=<token-bearer-compartilhado>

# Publicação de Shorts via YouTube Data API v3 (mesmo cliente OAuth da API)
# Manter APP_SECRET igual ao serviço de API para descriptografar tokens existentes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
APP_SECRET=

# Enviar vídeos como PRIVATE por padrão; público só com aprovação explícita.
